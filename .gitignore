# Keil MDK-ARM 项目 .gitignore 文件
# 用于STM32F4 FreeRTOS项目

# ============================================
# Keil 编译输出文件 (OBJ目录)
# ============================================
02源代码(VET6)/OBJ/*.o
02源代码(VET6)/OBJ/*.d
02源代码(VET6)/OBJ/*.crf
02源代码(VET6)/OBJ/*.lnp
02源代码(VET6)/OBJ/*.plg
02源代码(VET6)/OBJ/*.htm
02源代码(VET6)/OBJ/*.sct
02源代码(VET6)/OBJ/*.axf
02源代码(VET6)/OBJ/*.elf
02源代码(VET6)/OBJ/*.hex
02源代码(VET6)/OBJ/*.bin
02源代码(VET6)/OBJ/*.map
02源代码(VET6)/OBJ/*.lst
02源代码(VET6)/OBJ/*.tra
02源代码(VET6)/OBJ/*.dep
02源代码(VET6)/OBJ/build_log.htm
02源代码(VET6)/OBJ/*.uvgui.*
02源代码(VET6)/OBJ/*.uvoptx

# ============================================
# Keil 生成的临时文件和配置
# ============================================
**/*.uvgui.*
**/*.uvoptx
**/*.uvprojx.user
**/JLinkLog.txt
**/JLinkSettings.ini.bak

# ============================================
# Keil 备份文件
# ============================================
**/*.bak
**/*.old
**/*.backup

# ============================================
# 操作系统生成的文件
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ============================================
# 编辑器生成的文件
# ============================================
# VSCode
.vscode/
*.code-workspace

# Other IDEs
.idea/
*.swp
*.swo
*~

# ============================================
# 日志文件
# ============================================
*.log

# ============================================
# 压缩包和临时文件
# ============================================
*.zip
*.rar
*.7z
*.tar.gz
*.tmp

# ============================================
# 保留重要的Keil项目文件（不要忽略）
# ============================================
# *.uvprojx - Keil项目文件（需要版本控制）
# *.uvoptx - Keil选项文件（可选，但建议保留）
# *.c, *.h - 源代码文件
# *.s - 汇编文件
